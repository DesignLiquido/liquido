{
    "name": "liquido",
    "description": "Conjunto de ferramentas para desenvolvimento de aplicações para a internet 100% em português",
    "version": "1.3.0",
    "author": "Leonel Sanches da Silva",
    "contributors": [
        {
            "name": "Leonel Sanches da Silva",
            "url": "https://www.linkedin.com/in/leonelsanchesdasilva/"
        },
        {
            "name": "Italo Brito Brandão",
            "url": "https://github.com/ItaloCobains"
        },
        {
            "name": "Victor Francelino",
            "url": "https://github.com/VictorFrancelino"
        }
    ],
    "keywords": [
        "português",
        "delegua",
        "lmht",
        "foles",
        "lincones"
    ],
    "license": "MIT",
    "delegua": {
        "definicoes": "./definicoes"
    },
    "delprops": [
        {
            "espacoNomes": "liquido.arquetipo",
            "esquema": "./delprops/arquetipo"
        },
        {
            "espacoNomes": "liquido.linguagem",
            "esquema": "./delprops/linguagem"
        },
        {
            "espacoNomes": "liquido.aplicacao",
            "esquema": "./delprops/aplicacao"
        },
        {
            "espacoNomes": "liquido.roteador",
            "esquema": "./delprops/roteador"
        },
        {
            "espacoNomes": "liquido.autenticacao",
            "esquema": "./delprops/autenticacao"
        }
    ],
    "peerDependencies": {
        "@designliquido/delegua-entidades": "^0.1.0"
    },
    "peerDependenciesMeta": {
        "@designliquido/delegua-entidades": {
            "optional": true
        }
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "bin": {
        "liquido": "bin/liquido"
    },
    "scripts": {
        "empacotar": "yarn rimraf ./dist && tsc && yarn copyfiles -V ./bin/liquido ./bin/liquido.cmd ./dist && yarn copyfiles -V ./README.md ./dist && yarn copyfiles -u 1 -V \"./fontes/interface-linha-comando/exemplos/**/*\" ./dist && yarn copyfiles -u 1 -V \"./fontes/definicoes/**/*\" ./dist",
        "publicar-npm": "npm publish --access public",
        "iniciar": "nodemon",
        "lint-ts": "npx tslint -c tslint.json 'infraestrutura/*.ts'  '*.ts' 'interfaces/*.ts'",
        "lint": "yarn eslint . --ext .ts",
        "prettier-format": "yarn prettier --config .prettierrc infraestrutura/*.ts interfaces/*.ts *.ts --write",
        "testes": "yarn jest --coverage",
        "testes:w": "yarn jest --runInBand --watchAll",
        "predev": "yarn swagger",
        "prebuild": "yarn swagger",
        "dev": "concurrently \"nodemon\" \"nodemon -x tsoa spec\"",
        "swagger": "tsoa spec",
        "testes-unitarios": "yarn jest --coverage"
    },
    "dependencies": {
        "@designliquido/delegua-node": "^1.22.4",
        "@designliquido/delprops": "^0.1.0",
        "@designliquido/flexoes": "^0.1.0",
        "@designliquido/foles": "^0.15.1",
        "@designliquido/lincones-js": "^0.2.4",
        "@designliquido/lincones-sqlite": "^0.3.2",
        "@designliquido/lmht-js": "^0.6.2",
        "body-parser": "^1.20.3",
        "chalk": "4.1.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.2.1",
        "fast-glob": "^3.3.2",
        "figlet": "^1.8.0",
        "handlebars": "^4.7.8",
        "helmet": "^8.1.0",
        "jwt-simple": "^0.5.6",
        "morgan": "^1.10.0",
        "nodemon": "^3.1.9",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "prompts": "^2.4.2",
        "redoc-express": "^2.1.0",
        "xml2js": "^0.6.2",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.5",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/dotenv": "^8.2.3",
        "@types/express": "^5.0.6",
        "@types/figlet": "^1.7.0",
        "@types/jest": "^30.0.0",
        "@types/jwt-simple": "^0.5.36",
        "@types/morgan": "^1.9.9",
        "@types/node": "^25.0.0",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/prompts": "^2.4.9",
        "@types/xml2js": "^0.4.14",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "concurrently": "^9.1.2",
        "copyfiles": "^2.4.1",
        "eslint": "^9.24.0",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-prettier": "^5.2.6",
        "jest": "^29.7.0",
        "prettier": "^3.5.3",
        "release-it": "^18.1.2",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.3.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
