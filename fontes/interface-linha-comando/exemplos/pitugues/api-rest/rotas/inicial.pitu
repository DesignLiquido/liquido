@rest.documentacao(
    sumario = "Um exemplo de rota GET.",
    descricao = "Uma descrição mais detalhada sobre como a rota GET funciona.",
    idOperacao = "lerArtigos",
    etiquetas = ["artigos"]
)
@rest.resposta(
    codigo = 200,
    descricao = "Devolvido com sucesso",
    formatos = ["application/json", "application/xml"]
)
funcao rotaGet(requisicao, resposta):
    resposta.json([{
        "id": 1,
        "titulo": "teste 1",
        "descricao": "descricao 1"
    }])

funcao rotaPost(requisicao, resposta):
    resposta.json([{
        "id": 2,
        "titulo": "teste 2",
        "descricao": "descricao 2"
    }])
    
liquido.rotaGet(rotaGet)
liquido.rotaPost(rotaPost)