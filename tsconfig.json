{
    "compilerOptions": {
        "ignoreDeprecations": "5.0",
        "types": ["node", "jest"],
        "paths": {
            "@designliquido/delegua": ["./node_modules/@designliquido/delegua"],
            "@designliquido/delegua/*": ["./node_modules/@designliquido/delegua/*"]
        },
        "outDir": "dist",
        "module": "commonjs",
        "target": "ES2017",
        "rootDir": "fontes",
        "allowJs": true,
        "sourceMap": true,
        "declaration": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "resolveJsonModule": true
    },
    "include": [
        "fontes/**/*"
    ],
    "exclude": [
        "babel.config.js",
        "coverage/**/*",
        "dist/**/*",
        "jest.config.ts",
        "testes/**/*"
    ]
}