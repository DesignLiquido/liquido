{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "@designliquido/delegua": ["node_modules/@designliquido/delegua/dist"],
            "@designliquido/delegua/*": ["node_modules/@designliquido/delegua/dist/*"]
        },
        "outDir": "dist",
        "module": "commonjs",
        "target": "ES2017",
        "rootDir": ".",
        "allowJs": true,
        "sourceMap": true,
        "declaration": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "babel.config.js",
        "dist/**/*"
    ]
}